,"linkUrl":"https://tutorial.gst.gov.in/einvoice/images/e-Invoice_Mobile_Banner-4_767x350.gif","mode":"MOBILE"},{"order":4,"linkUrl":"https://tutorial.gst.gov.in/einvoice/images/e-Invoice_Mobile_Banner-4_767x350_hindi.gif","mode":"MOBILE"},{"order":5,"linkUrl":"https://tutorial.gst.gov.in/einvoice/images/e-Invoice_Mobile_Banner-5_767x350.gif","mode":"MOBILE"},{"order":5,"linkUrl":"https://tutorial.gst.gov.in/einvoice/images/e-Invoice_Mobile_Banner-5_767x350_hindi.gif","mode":"MOBILE"}]} @ https://einvoice.gst.gov.in/uiassets/js/main.js:0
