[31940920ms] [LOG] sessionData {"data":[{"order":1,"linkUrl":"https://tutorial.gst.gov.in/einvoice/images/e-Invoice_Banner-1_1920x320.gif","mode":"DESKTOP"},{"order":1,"linkUrl":"https://tutorial.gst.gov.in/einvoice/images/e-Invoice_Banner-1_1920x320_hindi.gif","mode":"DESKTOP"},{"order":2,"linkUrl":"https://tutorial.gst.gov.in/einvoice/images/e-Invoice_Banner-2_1920x320.gif","mode":"DESKTOP"},{"order":2,"linkUrl":"https://tutorial.gst.gov.in/einvoice/images/e-Invoice_Banner-2_1920x320_hindi.gif","mode":"DESKTOP"},{"order":3,"linkUrl":"https://tutorial.gst.gov.in/einvoice/images/e-Invoice_Banner-3_1920x320.gif","mode":"DESKTOP"},{"order":3,"linkUrl":"https://tutorial.gst.gov.in/einvoice/images/e-Invoice_Banner-3_1920x320_hindi.gif","mode":"DESKTOP"},{"order":4,"linkUrl":"https://tutorial.gst.gov.in/einvoice/images/e-Invoice_Banner-4_1920x320.gif","mode":"DESKTOP"},{"order":4,"linkUrl":"https://tutorial.gst.gov.in/einvoice/images/e-Invoice_Banner-4_1920x320_hindi.gif","mode":"DESKTOP"},{"order":5,"linkUrl":"https://tutorial.gst.gov.in/einvoice/images/e-Invoice_Banner-5_1920x320.gif","mode":"DESKTOP"},{"order":5,"linkUrl":"https://tutorial.gst.gov.in/einvoice/images/e-Invoice_Banner-5_1920x320_hindi.gif","mode":"DESKTOP"},{"order":1,"linkUrl":"https://tutorial.gst.gov.in/einvoice/images/e-Invoice_Mobile_Banner-1_767x350.gif","mode":"MOBILE"},{"order":1,"linkUrl":"https://tutorial.gst.gov.in/einvoice/images/e-Invoice_Mobile_Banner-1_767x350_hindi.gif","mode":"MOBILE"},{"order":2,"linkUrl":"https://tutorial.gst.gov.in/einvoice/images/e-Invoice_Mobile_Banner-2_767x350.gif","mode":"MOBILE"},{"order":2,"linkUrl":"https://tutorial.gst.gov.in/einvoice/images/e-Invoice_Mobile_Banner-2_767x350_hindi.gif","mode":"MOBILE"},{"order":3,"linkUrl":"https://tutorial.gst.gov.in/einvoice/images/e-Invoice_Mobile_Banner-3_767x350.gif","mode":"MOBILE"},{"order":3,"linkUrl":"https://tutorial.gst.gov.in/einvoice/images/e-Invoice_Mobile_Banner-3_767x350_hindi.gif","mode":"MOBILE"},{"order":4,"linkUrl":"https://tutorial.gst.gov.in/einvoice/images/e-Invoice_Mobile_Banner-4_767x350.gif","mode":"MOBILE"},{"order":4,"linkUrl":"https://tutorial.gst.gov.in/einvoice/images/e-Invoice_Mobile_Banner-4_767x350_hindi.gif","mode":"MOBILE"},{"order":5,"linkUrl":"https://tutorial.gst.gov.in/einvoice/images/e-Invoice_Mobile_Banner-5_767x350.gif","mode":"MOBILE"},{"order":5,"linkUrl":"https://tutorial.gst.gov.in/einvoice/images/e-Invoice_Mobile_Banner-5_767x350_hindi.gif","mode":"MOBILE"}]} @ https://einvoice.gst.gov.in/uiassets/js/main.js:0
