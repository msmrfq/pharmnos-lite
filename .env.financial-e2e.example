# Copy to .env.financial-e2e locally. Never commit the local copy.
FINANCIAL_E2E_DB_USER=pharmnos_e2e
FINANCIAL_E2E_DB_PASSWORD=replace-with-a-local-random-password
FINANCIAL_E2E_DB_NAME=pharmnos_financial_e2e
FINANCIAL_E2E_DB_PORT=<operator-assigned-non-default-port>
FINANCIAL_E2E_COMPOSE_PROJECT=<operator-assigned-compose-project>
FINANCIAL_E2E_ENV_FILE=.env.financial-e2e
FINANCIAL_E2E_TARGET_CONTRACT=<operator-supplied-serialized-contract>
FINANCIAL_E2E_RUN_ID=<contract-run-id>
FINANCIAL_E2E_TARGET_APPROVED=true
FINANCIAL_E2E_AUTHORIZED_TARGET_BINDING=<contract-binding>
FINANCIAL_E2E_AUTHORIZED_TARGET_FINGERPRINT=<full-contract-fingerprint>
FINANCIAL_E2E_INFRASTRUCTURE_AUTHORIZED=true
FINANCIAL_E2E_INITIALIZATION_AUTHORIZED=true
FINANCIAL_E2E_EXECUTION_AUTHORIZED=true
FINANCIAL_E2E_EVIDENCE_RECORDING_AUTHORIZED=true
FINANCIAL_E2E_CLEANUP_AUTHORIZED=false
FINANCIAL_E2E_CLEANUP_MODE=DISPOSABLE_TARGET_DISPOSAL
# Target-bound suite identity (T19 only); T13/T25 use their offline runners.
FINANCIAL_E2E_SUITE_NAME=purchase-gst
FINANCIAL_E2E_INFRASTRUCTURE_EVIDENCE_FILE=.obsidian-vault/specs/financial-e2e-infrastructure-evidence.json
FINANCIAL_E2E_INITIALIZATION_EVIDENCE_FILE=.obsidian-vault/specs/financial-e2e-initialization-evidence.json
# Use a distinct append-only path for each suite execution.
FINANCIAL_E2E_SUITE_EVIDENCE_FILE=.obsidian-vault/specs/financial-e2e-<suite>-evidence.json
FINANCIAL_E2E_CLEANUP_EVIDENCE_FILE=.obsidian-vault/specs/financial-e2e-cleanup-evidence.json

# Independent offline function-suite evidence paths (T13 and T25).
# Leave unset to use a unique append-only path under .obsidian-vault/specs/.
T13_EVIDENCE_FILE=.obsidian-vault/specs/t13-gstin-verification-evidence-<run-id>.json
T25_EVIDENCE_FILE=.obsidian-vault/specs/t25-gst-calculation-treatment-evidence-<run-id>.json

# Export separately before running the guarded harness.
# ALLOW_FINANCIAL_E2E=true
# TEST_DATABASE_URL=postgresql://pharmnos_e2e:<password>@127.0.0.1:<operator-assigned-port>/pharmnos_financial_e2e_<unique-suffix>?application_name=pharmnos-financial-e2e
# TEST_DATABASE_NAME=pharmnos_financial_e2e
# TEST_DATABASE_MARKER=pharmnos-financial-e2e
# FINANCIAL_E2E_RUNTIME_DATABASE_URL=postgresql://pharmnos_e2e_runtime:<runtime-password>@127.0.0.1:<operator-assigned-port>/pharmnos_financial_e2e_<unique-suffix>?application_name=pharmnos-financial-e2e
# FINANCIAL_E2E_RUNTIME_DB_USER=pharmnos_e2e_runtime
# FINANCIAL_E2E_RUNTIME_DB_PASSWORD=<runtime-password>
# DATABASE_URL=postgresql://<ordinary-local-role>:<password>@127.0.0.1:<ordinary-local-port>/<ordinary-local-database>
